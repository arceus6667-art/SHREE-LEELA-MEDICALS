APP_URL=http://localhost:3000
SESSION_SECRET=
SQLITE_DATABASE_PATH=./data/shree_leela_live.db
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Allow checkout only after the store completes onboarding and sets this flag.
PRODUCTION_SALES_APPROVED=false

# Optional integrations. Keep provider secrets on the server.
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set STORAGE_DRIVER=supabase to store pharmacy files in a private bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=
SUPABASE_SECRET_KEY=
