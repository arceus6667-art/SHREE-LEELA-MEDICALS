# GEMINI_API_KEY: Optional for future server-side AI features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret key used to sign HTTP-only session cookies.
SESSION_SECRET="change-me-in-production-min-32-chars"

# DATABASE_URL: PostgreSQL connection string when migrating from local SQLite runtime to PostgreSQL/Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shree_leela_pharmacy?schema=public"

# STORAGE_DRIVER: "local" | "s3" | "supabase"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./data/uploads"

# VITE_GOOGLE_MAPS_API_KEY: Optional Google Maps JavaScript API key for live interactive map tiles.
VITE_GOOGLE_MAPS_API_KEY=""

# DEMO_MODE: Set to "false" in production once real store inventory is imported.
DEMO_MODE="true"
