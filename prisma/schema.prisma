// Prisma Schema for Shree Leela Medical & General Stores
// Target Database: PostgreSQL (with multi-store & multi-tenant foundation)
// Monetary fields are stored strictly as integer paise (INR * 100).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  STORE_ADMIN
  PHARMACIST
  INVENTORY_MANAGER
  DELIVERY_PARTNER
  CUSTOMER
}

enum OrderStatus {
  PENDING_PRESCRIPTION
  PENDING_CONFIRMATION
  CONFIRMED
  PACKING
  READY_FOR_DISPATCH
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PrescriptionStatus {
  NOT_REQUIRED
  PENDING_REVIEW
  APPROVED
  REJECTED
  CLARIFICATION_NEEDED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DeliveryAssignmentStatus {
  ASSIGNED
  ACCEPTED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum InventoryTxnType {
  OPENING_STOCK
  PURCHASE_RECEIPT
  SALE_DISPATCH
  RETURN_RESTOCK
  EXPIRED_WRITEOFF
  MANUAL_ADJUSTMENT
}

model Business {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  legalName    String?
  gstin        String?
  currency     String   @default("INR")
  timezone     String   @default("Asia/Kolkata")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stores         Store[]
  users          User[]
  categories     Category[]
  manufacturers  Manufacturer[]
  suppliers      Supplier[]
  medicines      Medicine[]
  coupons        Coupon[]
  auditLogs      AuditLog[]
}

model Store {
  id                   String   @id @default(uuid()) @db.Uuid
  businessId           String   @db.Uuid
  code                 String   @unique
  name                 String
  addressLine1         String
  landmark             String?
  city                 String
  state                String
  postalCode           String
  country              String   @default("India")
  phone                String
  email                String?
  operatingHours       String
  latitude             Float
  longitude            Float
  googleMapsUrl        String?
  drugLicenseNumber    String?
  logoPlaceholder      Boolean  @default(true)
  logoUrl              String?
  storefrontPhotoUrl   String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  business              Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userRoles             UserRole[]
  employeeProfiles      EmployeeProfile[]
  deliveryPartners      DeliveryPartner[]
  batches               MedicineBatch[]
  inventoryTransactions InventoryTransaction[]
  carts                 Cart[]
  orders                Order[]
  prescriptions         Prescription[]
  deliveryAssignments   DeliveryAssignment[]
  supportTickets        SupportTicket[]
  settings              StoreSetting[]
  auditLogs             AuditLog[]

  @@index([businessId])
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  businessId          String    @db.Uuid
  email               String    @unique
  phone               String?   @unique
  fullName            String
  passwordHash        String
  isEmailVerified     Boolean   @default(false)
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roles               UserRole[]
  customerProfile     CustomerProfile?
  employeeProfile     EmployeeProfile?
  deliveryPartner     DeliveryPartner?
  addresses           Address[]
  carts               Cart[]
  orders              Order[]
  prescriptions       Prescription[]
  prescriptionReviews PrescriptionReview[]
  notifications       Notification[]
  supportTickets      SupportTicket[]
  auditLogs           AuditLog[]

  @@index([businessId])
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  storeId    String?  @db.Uuid
  role       Role
  assignedBy String?  @db.Uuid
  createdAt  DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId, role])
  @@index([role])
}

model CustomerProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  dateOfBirth        DateTime?
  allergiesNote      String?
  chronicConditions  String?
  preferredLanguage  String   @default("en")
  loyaltyPoints      Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmployeeProfile {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @db.Uuid
  storeId              String   @db.Uuid
  employeeCode         String   @unique
  designation          String
  pharmacistRegNumber  String?
  joinedAt             DateTime @default(now())
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model DeliveryPartner {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  storeId         String   @db.Uuid
  vehicleType     String
  vehicleNumber   String
  licenseNumber   String?
  isAvailable     Boolean  @default(true)
  isOnShift       Boolean  @default(false)
  currentLat      Float?
  currentLng      Float?
  lastLocationAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  store       Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  assignments DeliveryAssignment[]
  locations   DriverLocation[]

  @@index([storeId, isAvailable])
}

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  label         String
  recipientName String
  phone         String
  line1         String
  line2         String?
  landmark      String?
  city          String
  state         String
  postalCode    String
  latitude      Float?
  longitude     Float?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

model Category {
  id            String        @id @default(uuid()) @db.Uuid
  businessId    String        @db.Uuid
  name          String
  slug          String        @unique
  description   String?
  displayOrder  Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subcategories Subcategory[]
  medicines     Medicine[]

  @@index([businessId])
}

model Subcategory {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String   @db.Uuid
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  medicines Medicine[]

  @@index([categoryId])
}

model Manufacturer {
  id        String   @id @default(uuid()) @db.Uuid
  businessId String  @db.Uuid
  name      String
  country   String   @default("India")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  medicines Medicine[]

  @@unique([businessId, name])
}

model Medicine {
  id                   String   @id @default(uuid()) @db.Uuid
  businessId           String   @db.Uuid
  categoryId           String   @db.Uuid
  subcategoryId        String?  @db.Uuid
  manufacturerId       String   @db.Uuid
  sku                  String   @unique
  name                 String
  slug                 String   @unique
  genericName          String
  composition          String
  dosageForm           String
  packSize             String
  scheduleType         String   @default("OTC")
  requiresPrescription Boolean  @default(false)
  mrpPaise             Int
  salePricePaise       Int
  gstPercent           Int      @default(12)
  hsnCode              String?
  storageInstructions  String?
  usageSummary         String?
  sideEffectsSummary   String?
  safetyAdvice         String?
  isActive             Boolean  @default(true)
  isDemoData           Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category     Category        @relation(fields: [categoryId], references: [id])
  subcategory  Subcategory?    @relation(fields: [subcategoryId], references: [id])
  manufacturer Manufacturer    @relation(fields: [manufacturerId], references: [id])
  images       MedicineImage[]
  batches      MedicineBatch[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([businessId, categoryId])
  @@index([name])
}

model MedicineImage {
  id         String   @id @default(uuid()) @db.Uuid
  medicineId String   @db.Uuid
  imageUrl   String
  altText    String
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([medicineId])
}

model Supplier {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @db.Uuid
  name         String
  contactName  String?
  phone        String
  email        String?
  gstin        String?
  drugLicense  String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  batches  MedicineBatch[]
}

model MedicineBatch {
  id                 String   @id @default(uuid()) @db.Uuid
  storeId            String   @db.Uuid
  medicineId         String   @db.Uuid
  supplierId         String?  @db.Uuid
  batchNumber        String
  expiryDate         DateTime
  quantityReceived   Int
  quantityAvailable  Int
  purchasePricePaise Int
  mrpPaise           Int
  isDemoData         Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  store        Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  medicine     Medicine               @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  supplier     Supplier?              @relation(fields: [supplierId], references: [id])
  transactions InventoryTransaction[]
  orderItems   OrderItem[]

  @@unique([storeId, medicineId, batchNumber])
  @@index([storeId, expiryDate])
}

model InventoryTransaction {
  id              String           @id @default(uuid()) @db.Uuid
  storeId         String           @db.Uuid
  batchId         String           @db.Uuid
  txnType         InventoryTxnType
  quantityDelta   Int
  referenceType   String?
  referenceId     String?
  notes           String?
  performedById   String?          @db.Uuid
  createdAt       DateTime         @default(now())

  store Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  batch MedicineBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  storeId   String     @db.Uuid
  userId    String?    @db.Uuid
  guestKey  String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  store Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
}

model CartItem {
  id         String   @id @default(uuid()) @db.Uuid
  cartId     String   @db.Uuid
  medicineId String   @db.Uuid
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([cartId, medicineId])
}

model Order {
  id                 String             @id @default(uuid()) @db.Uuid
  storeId            String             @db.Uuid
  userId             String             @db.Uuid
  addressId          String?            @db.Uuid
  couponId           String?            @db.Uuid
  orderNumber        String             @unique
  status             OrderStatus        @default(PENDING_CONFIRMATION)
  prescriptionStatus PrescriptionStatus @default(NOT_REQUIRED)
  subtotalPaise      Int
  discountPaise      Int                @default(0)
  deliveryFeePaise   Int                @default(0)
  taxPaise           Int                @default(0)
  totalPaise         Int
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus      @default(PENDING)
  deliveryNotes      String?
  deliveryOtp        String?
  isDemoData         Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  store              Store                @relation(fields: [storeId], references: [id])
  user               User                 @relation(fields: [userId], references: [id])
  address            Address?             @relation(fields: [addressId], references: [id])
  coupon             Coupon?              @relation(fields: [couponId], references: [id])
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  prescriptions      Prescription[]
  deliveryAssignment DeliveryAssignment?
  payments           Payment[]
  invoice            Invoice?

  @@index([storeId, status])
  @@index([userId, createdAt])
}

model OrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @db.Uuid
  medicineId     String   @db.Uuid
  batchId        String?  @db.Uuid
  medicineName   String
  packSize       String
  quantity       Int
  unitPricePaise Int
  mrpPaise       Int
  taxPaise       Int
  lineTotalPaise Int
  createdAt      DateTime @default(now())

  order    Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicine Medicine       @relation(fields: [medicineId], references: [id])
  batch    MedicineBatch? @relation(fields: [batchId], references: [id])

  @@index([orderId])
}

model OrderStatusHistory {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @db.Uuid
  status      OrderStatus
  note        String?
  changedById String?     @db.Uuid
  createdAt   DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Prescription {
  id            String             @id @default(uuid()) @db.Uuid
  storeId       String             @db.Uuid
  userId        String             @db.Uuid
  orderId       String?            @db.Uuid
  fileUrl       String
  fileMimeType  String
  patientName   String
  doctorName    String?
  notes         String?
  status        PrescriptionStatus @default(PENDING_REVIEW)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  store   Store                @relation(fields: [storeId], references: [id])
  user    User                 @relation(fields: [userId], references: [id])
  order   Order?               @relation(fields: [orderId], references: [id])
  reviews PrescriptionReview[]

  @@index([storeId, status])
}

model PrescriptionReview {
  id             String             @id @default(uuid()) @db.Uuid
  prescriptionId String             @db.Uuid
  pharmacistId   String             @db.Uuid
  decision       PrescriptionStatus
  remarks        String?
  createdAt      DateTime           @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  pharmacist   User         @relation(fields: [pharmacistId], references: [id])

  @@index([prescriptionId])
}

model DeliveryAssignment {
  id                String                   @id @default(uuid()) @db.Uuid
  storeId           String                   @db.Uuid
  orderId           String                   @unique @db.Uuid
  deliveryPartnerId String                   @db.Uuid
  status            DeliveryAssignmentStatus @default(ASSIGNED)
  assignedAt        DateTime                 @default(now())
  pickedUpAt        DateTime?
  deliveredAt       DateTime?
  proofNote         String?
  updatedAt         DateTime                 @updatedAt

  store           Store           @relation(fields: [storeId], references: [id])
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPartner DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id])

  @@index([deliveryPartnerId, status])
}

model DriverLocation {
  id                String   @id @default(uuid()) @db.Uuid
  deliveryPartnerId String   @db.Uuid
  orderId           String?  @db.Uuid
  latitude          Float
  longitude         Float
  heading           Float?
  speedKmh          Float?
  recordedAt        DateTime @default(now())

  deliveryPartner DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)

  @@index([deliveryPartnerId, recordedAt])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @db.Uuid
  method            PaymentMethod
  status            PaymentStatus
  amountPaise       Int
  providerReference String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
}

model Refund {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @db.Uuid
  amountPaise Int
  reason      String
  status      String   @default("PROCESSED")
  processedBy String?  @db.Uuid
  createdAt   DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @unique @db.Uuid
  invoiceNumber String   @unique
  subtotalPaise Int
  taxPaise      Int
  discountPaise Int
  totalPaise    Int
  issuedAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Coupon {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @db.Uuid
  code            String   @unique
  description     String
  discountType    String
  discountValue   Int
  minOrderPaise   Int      @default(0)
  maxDiscountPaise Int?
  isActive        Boolean  @default(true)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders   Order[]
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model SupportTicket {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @db.Uuid
  userId    String?  @db.Uuid
  name      String
  phone     String
  email     String?
  subject   String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])
  user  User? @relation(fields: [userId], references: [id])

  @@index([storeId, status])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @db.Uuid
  storeId     String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  store    Store?   @relation(fields: [storeId], references: [id])
  actor    User?    @relation(fields: [actorUserId], references: [id])

  @@index([businessId, createdAt])
}

model StoreSetting {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @db.Uuid
  key       String
  value     String
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
}
